# Required for signing JWT access and refresh tokens. Generate a long random value.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:8080,https://hostel-hub-management-system-yzo8.onrender.com

# Optional: creates the initial admin only when both values are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=System Administrator

# Optional: creates one initial worker for local demos. Additional workers are
# created by a signed-in admin using the Admin dashboard.
BOOTSTRAP_WORKER_EMAIL=worker@example.com
BOOTSTRAP_WORKER_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_WORKER_NAME=Maintenance Worker
BOOTSTRAP_WORKER_TYPE=General

# Local Night Canteen image storage. Use object storage through a dedicated
# adapter before production deployment; do not point this inside source control.
NIGHT_CANTEEN_UPLOAD_DIR=uploads/night-canteen
